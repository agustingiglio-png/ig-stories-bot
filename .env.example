# ============================================================================
#  ig-stories-bot  ·  variables de entorno
#  Copiá este archivo como .env  ->  cp .env.example .env   (NO subir .env a git)
#  En GitHub Actions estos valores van como "Secrets", NO como archivo .env.
# ============================================================================

# Token de acceso de larga duracion (long-lived) de Instagram.
# Dura ~60 dias. El sistema lo refresca solo. Obtencion: ver README paso 5.
IG_ACCESS_TOKEN=

# ID numerico de tu cuenta profesional de Instagram.
# Si lo dejas vacio, el sistema lo resuelve solo con /me y lo cachea.
IG_USER_ID=

# App Secret de tu app de Meta. SOLO se usa una vez para el intercambio inicial
# short-lived -> long-lived (comando: python manage.py exchange-token).
# El refresco diario/semanal NO lo necesita. Podes dejarlo vacio despues.
IG_APP_SECRET=

# Version del Graph API a usar. Verificada al 2026-08-19: v23.0
GRAPH_VERSION=v23.0

# Binario de cloudflared (tunel efimero). Vacio = se busca en el PATH.
# En GitHub Actions el workflow lo instala solo.
CLOUDFLARED_BIN=

# (Opcional) Token de Github (PAT) para que el workflow de refresco pueda
# reescribir el secret IG_ACCESS_TOKEN. Solo se usa en la nube. Local: vacio.
GH_PAT=
